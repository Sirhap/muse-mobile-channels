[Unit]
Description=WeCom smart robot long-connection gateway for Muse
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=hatch
Group=hatch
WorkingDirectory=/home/hatch/workspace/wecom-bot
Environment=PYTHONUNBUFFERED=1
Environment=WECOM_CRED_FILE=/home/hatch/.config/wecom-bot/credentials.env
EnvironmentFile=-/etc/environment
Environment=HOME=/home/hatch
Environment=MUSE_HOME=/home/hatch
ExecStart=/home/hatch/workspace/wecom-bot/.venv/bin/python /home/hatch/workspace/wecom-bot/gateway.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
