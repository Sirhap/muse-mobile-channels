[Unit]
Description=Feishu / Lark smart robot long-connection gateway for Muse
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/hatch/workspace/feishu-bot
Environment=PYTHONUNBUFFERED=1
Environment=FEISHU_CRED_FILE=/home/hatch/.config/feishu-bot/credentials.env
EnvironmentFile=-/etc/environment
EnvironmentFile=-/home/hatch/.config/feishu-bot/notice.env
Environment=HOME=/home/hatch
Environment=MUSE_HOME=/home/hatch
ExecStart=/home/hatch/workspace/feishu-bot/.venv/bin/python /home/hatch/workspace/feishu-bot/gateway.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
