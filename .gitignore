# Blacklist .gitignore — normal project style.
# Everything is tracked by default; only the patterns below are ignored.
# Converted from whitelist 2026-11-06 at user request.
#
# HARD RULE: private files must NEVER be uploaded. The "Private / sensitive"
# section below is the safety net — it covers credentials, keys, tokens,
# pairing material and runtime state at ANY depth. Do not remove entries
# from that section. If a new sensitive file type appears, add it there
# before anything else.

# ---------------------------------------------------------------------------
# Private / sensitive — NEVER commit, at any depth
# ---------------------------------------------------------------------------
# Gadget device credentials (pairing material, any directory)
pairing.json
identity.json
sdk_token
pair.lock
# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.der
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
# Credential and secret files
credentials.env
.env
*.env
cookies.txt
cookies.json
token.json
vm_id.txt
*credentials*.json
*secret*.json
# SSH
.ssh/
# Runtime databases and state (may contain message content / tokens)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db
decisions.jsonl
decisions.lock
decisions.offset
state.json
status.json
# Approval / relay runtime
approval-relay/decisions.jsonl
approval-relay/decisions.lock
approval-relay/decisions.offset
approval-relay/state.json
approval-relay/status.json
native-bridge/state.json
native-bridge/status.json
native-bridge/config.json
cloudflare-tunnel-plugin/plugin.conf

# ---------------------------------------------------------------------------
# Build artifacts, caches, generated files
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
*.log
*.bak
*.bak-*
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Runtime state directories (live services write here)
# ---------------------------------------------------------------------------
state/
native-bridge/spool/
native-bridge/shadow/
native-bridge/enabled-*
native-bridge/divert-*
native-bridge/longtask-*
native-bridge/queue_admin-*.jsonl
native-bridge/probe_*.py
native-probe/probe*_results.txt
native-probe/probe*_stdout.log
native-probe/probe*_*.log
channel-restore/outbound-probe-draft-*.md
channel-restore/muse-core-run.service
channel-restore/outbound_probe_state.json
native-bridge/.fallback-weixin
hooks/state/
hooks/*.pid
*.pid
*.lock

