# Workspace repo: only the channel code is tracked. Everything else in
# ~/workspace (evidence files, research clones, backups, goals) stays out.
/*
!/.gitignore
!/README.md
!/HEARTBEAT.md
!/CONTRIBUTING.md
!/LICENSE
!/.github/
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.md
!/weixin-bot/
!/wecom-bot/
!/channel-restore/
!/channel_common.py
!/death_watch_activity.py
!/hooks/
!/hooks/scripts/
!/hooks/scripts/*.sh
!/hooks/definitions/
!/hooks/definitions/*.json
!/tests/
!/tests/*.py
!/docs/
!/docs/*.md
!/ops/
!/ops/cold_death_drill.py
!/ops/cold_death_live_second_judgment.py
!/native-probe/
!/native-probe/gw2.py
!/native-probe/README.md
!/slash-commands-2026-10-04.md
!/native-bridge/
!/native-bridge/native_bridge.py
!/native-bridge/config.json
!/native-bridge/native-bridge.service

# Runtime / local-only — never commit
native-bridge/state.json
native-bridge/status.json
native-bridge/spool/
native-bridge/shadow/
native-bridge/enabled-*
native-bridge/divert-*
native-bridge/longtask-*
native-bridge/queue_admin-*.jsonl
native-bridge/probe_*.py
# P3#11 result dumps and the channel-restore outbound draft.
# These do not match gw2.py, README.md, or other native-probe *.py deps.
# Hatch moves/deletes are done via Muse; this only keeps the dumps untracked.
native-probe/probe*_results.txt
native-probe/probe*_stdout.log
native-probe/probe*_*.log
channel-restore/outbound-probe-draft-*.md
.venv/
__pycache__/
*.pyc
state/
*.bak-*
*.bak
reply-*.txt
login-qr.png
credentials.env
.env

# Upstream reference clones (not our code)
wecom-bot/reference/
