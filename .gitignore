# Workspace repo: only the channel code is tracked. Everything else in
# ~/workspace (evidence files, research clones, backups, goals) stays out.
/*
!/.gitignore
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/.github/
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/*.md
!/weixin-bot/
!/wecom-bot/
!/channel-restore/
!/channel_common.py
!/hooks/
!/hooks/scripts/
!/hooks/scripts/*.sh
!/hooks/definitions/
!/hooks/definitions/*.json
!/tests/
!/tests/*.py
!/docs/
!/docs/*.md
!/native-probe/
# Whitelist: the reusable client only. One-off probe scripts, result
# dumps, and nested archives stay on the hatch VM (they were showing up
# as untracked). Last match wins — keep these two negations below the
# contents rule. See docs/hatch-untracked-disposition.md.
/native-probe/**
!/native-probe/gw2.py
!/native-probe/README.md
!/slash-commands-2026-10-04.md
!/native-bridge/
!/native-bridge/native_bridge.py
!/native-bridge/config.json
!/native-bridge/native-bridge.service

# Runtime / local-only — never commit
native-bridge/state.json
native-bridge/status.json
native-bridge/spool/
native-bridge/shadow/
native-bridge/enabled-*
native-bridge/divert-*
native-bridge/longtask-*
native-bridge/queue_admin-*.jsonl
native-bridge/probe_*.py
# Dated outbound-probe writeups (P3#11). Any directory, so a copy under
# channel-restore/ or docs/ does not become a dirty untracked file.
# Read the file on the VM that still has it before keeping or deleting;
# do not recreate it from memory.
outbound-probe-draft-*.md
.venv/
__pycache__/
*.pyc
state/
*.bak-*
*.bak
reply-*.txt
login-qr.png
credentials.env
.env

# Upstream reference clones (not our code)
wecom-bot/reference/
